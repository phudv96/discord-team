# ---- Discord ----
# Bot token: https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=

# Guild (server) ID để sync slash command ngay lập tức.
# Nhiều server thì ngăn cách bằng dấu phẩy:
#     DISCORD_GUILD_ID=111111111111111111,222222222222222222
# Lệnh CHỈ hiện trong đúng những server liệt kê ở đây. Bot có mặt ở server khác
# mà quên thêm id thì bên đó gõ /team sẽ ra text thường — bot cảnh báo lúc khởi động.
#
# ĐỂ TRỐNG nếu bạn dùng User Install (cài app vào tài khoản mình) — đây là cách
# nên dùng cho tool cá nhân: chạy được ở mọi server bạn có mặt lẫn trong DM, và
# KHÔNG cần quyền admin của server. Đổi lại, Discord mất vài phút tới ~1h mới
# hiện lệnh sau lần sync đầu.
#
# Chỉ điền ID nếu bạn có quyền Manage Server và muốn lệnh xuất hiện tức thì
# trong đúng server đó.
DISCORD_GUILD_ID=

# Giới hạn ai được chạy /team, ngăn cách bằng dấu phẩy.
# BỎ TRỐNG = cho phép mọi người trong server (dùng cái này nếu muốn cả nhóm gửi được).
# Lưu ý: tin nhắn tới Teams luôn mang danh nghĩa tài khoản Teams của BẠN,
# dù người gửi là ai. Tên người gửi Discord được ghi kèm qua MESSAGE_PREFIX.
ALLOWED_USER_IDS=

# Giới hạn tần suất mỗi user (giây). 0 = tắt.
# Nên để >0 khi mở cho cả server: chỉ có 1 tab Chromium nên spam sẽ làm nghẽn
# hàng đợi của tất cả mọi người.
COOLDOWN_SECONDS=10

# Trả lời trong Discord ở chế độ ẩn (chỉ người gọi thấy). 1 = bật, 0 = tắt.
# Khi mở cho cả nhóm, cân nhắc để 0 để mọi người thấy tin đã gửi và khỏi gửi trùng.
EPHEMERAL_REPLY=1

# ---- Teams ----
# Template tin nhắn gửi sang Teams.
# Biến dùng được: {user} {message} {channel} {guild}
MESSAGE_PREFIX=[Discord - {user}] {message}

# ---- Chiều ngược: Teams -> Discord ----
# ID KÊNH Discord để đẩy tin nhắn mới từ Teams về. Nhiều kênh thì ngăn cách
# bằng dấu phẩy (mỗi tin sẽ được gửi vào tất cả các kênh liệt kê).
# BỎ TRỐNG = tắt hẳn chiều này (chỉ Discord -> Teams).
#
# Đây là ID KÊNH, KHÁC với ID server ở DISCORD_GUILD_ID.
# Lấy đúng: chuột phải vào tên KÊNH trong danh sách kênh -> Copy Channel ID.
# (Chuột phải vào icon server sẽ ra Copy Server ID — dùng nhầm là relay không chạy.)
DISCORD_RELAY_CHANNEL_ID=

# Bao lâu kiểm tra tin mới một lần (giây). Tối thiểu 5.
RELAY_POLL_SECONDS=10

# CHỈ chuyển những tin Teams bắt đầu bằng chuỗi này, và cắt bỏ chuỗi đó đi:
#     Teams:   discord-cho tôi 1 ly trà sữa
#     Discord: cho tôi 1 ly trà sữa
# Không phân biệt hoa thường. Tin không có trigger sẽ bị bỏ qua hoàn toàn.
# ĐỂ RỖNG = chuyển MỌI tin trong group (nhóm đông người sẽ rất ồn).
RELAY_TRIGGER_PREFIX=discord-

# ---- Trình duyệt ----
# Chạy Chromium ẩn (1) hay hiện cửa sổ (0).
# Nếu bị Microsoft chặn hoặc selector không tìm thấy, thử đổi sang 0 để xem bot đang làm gì.
TEAMS_HEADLESS=1

# Timeout tối đa cho 1 lần gửi (giây).
# Lần gửi ĐẦU TIÊN sau khi bot khởi động phải chờ Teams web cold-start (~30-60s),
# các lần sau gần như tức thì. Đừng để dưới 90.
TEAMS_SEND_TIMEOUT=120
